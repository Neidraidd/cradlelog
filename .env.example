# Copy to .env (never commit .env).

# Optional. Leave empty and the first person to open the app is asked to choose the passcode.
# Or set one here: at least 8 characters, a long passphrase is best.
CRADLELOG_PASSCODE=

# The address people open the app at. Must be https in production.
PUBLIC_URL=https://cradlelog.example.com

# Timezone used for times written into notifications.
CRADLELOG_TZ=Europe/London

# 1 when the app sits behind one reverse proxy that sets X-Forwarded-For (the usual case).
# Set to 0 if the app is reachable directly, otherwise clients could fake their address.
TRUST_PROXY=1
